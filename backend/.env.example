DJANGO_SECRET_KEY=
# Signing key for access/refresh JWTs (rest_framework_simplejwt). Kept
# separate from DJANGO_SECRET_KEY so rotating one doesn't invalidate the
# other's tokens/sessions.
JWT_SECRET=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev only -- ignored whenever DATABASE_URL is set (see below).
DB_NAME=foresight_db
DB_USER=foresight_user
DB_PASSWORD=foresight_dev_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Production only (e.g. Neon connection string on Render). Takes priority
# over the discrete DB_* vars above when set; leave blank locally.
DATABASE_URL=

# Celery broker/result backend (docker-compose.yml's `redis` service). No
# manual setup needed -- `python start.py` brings this container up the same
# way it does Postgres.
REDIS_URL=redis://127.0.0.1:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000
# Must include scheme (http/https). Needed for CSRF-protected, cookie-based
# requests (Django admin, SessionAuthentication) from the frontend's origin.
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Production only -- deployed frontend origin (Vercel). Must include the
# scheme (https://...). Automatically added to CORS_ALLOWED_ORIGINS and
# CSRF_TRUSTED_ORIGINS above; leave blank locally.
FRONTEND_URL=

# Lemon Squeezy billing webhook signing secret (Settings -> Webhooks in the
# Lemon Squeezy dashboard). Required for backend/billing's webhook endpoint
# to accept any request -- without it, every webhook is rejected with 401.
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Local dev/demo super-admin account, seeded by `manage.py seed_demo_data`.
# Set the same username/password in frontend/.env.local as ADMIN_API_USERNAME
# / ADMIN_API_PASSWORD so the Next.js server can call the /api/v1/admin/
# endpoints. Dev-only credential, never used in production.
DJANGO_SUPERADMIN_USERNAME=
DJANGO_SUPERADMIN_PASSWORD=
